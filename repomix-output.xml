        expect(result.not_found).toContain('missing-agent');
      }
    });
  });


  describe('Full Flow: spawn -> status -> read -> stop', () => {
    test('should handle complete lifecycle (mocked agents)', async () => {
      console.log('\n--- TEST: complete agent lifecycle ---');

