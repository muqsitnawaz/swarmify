          settingsPanel?.webview.postMessage({ type: 'unifiedTasksData', tasks: unifiedTasks });
        } catch (err) {
          console.error('[SETTINGS] Error fetching unified tasks:', err);
          settingsPanel?.webview.postMessage({ type: 'unifiedTasksData', tasks: [] });
        }
        break;
      case 'startOAuth': {
