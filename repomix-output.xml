                </code>
                <select
                  value={slot?.agent || ''}
                  onChange={(e) => {
                    const agent = e.target.value
                    const newSlot: QuickLaunchSlot | undefined = agent
                      ? { agent, model: undefined, label: undefined }
                      : undefined
                    onSaveSettings({
                      ...settings,
                      quickLaunch: {
                        ...settings.quickLaunch,
