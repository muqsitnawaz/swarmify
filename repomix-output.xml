    expect(result.status).toBe('success');
    expect(result.sessionId).toBeTruthy();
    expect(result.sessionId).toMatch(/^[a-zA-Z0-9_-]+$/);
    console.log(`[E2E] Codex session ID extracted: ${result.sessionId}`);
