    return [
      'div',
      mergeAttributes({ class: 'notion-file-attachment' }),
      [
        'a',
        mergeAttributes(
          this.options.HTMLAttributes,
          {
            href: HTMLAttributes.href,
            'data-file-attachment': '',
            'data-file-name': HTMLAttributes['data-file-name'],
