      const agent2 = new AgentProcess('task-agent-2', 'feature-a', 'cursor', 'Work', '/a/b/d', 'plan', null, AgentStatus.COMPLETED, new Date('2025-01-01T10:05:00Z'), new Date('2025-01-01T10:10:00Z'));
