#!/bin/bash

json_input=$(cat)

tool_name=$(echo "$json_input" | jq -r '.tool_name // ""')
tool_input=$(echo "$json_input" | jq -r '.tool_input // ""')
message=$(echo "$json_input" | jq -r '.message // ""')

